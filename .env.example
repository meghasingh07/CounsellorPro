# Copy to .env.local (do not commit real secrets)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# Gmail SMTP (use Gmail app password)
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=

# Optional sender label; falls back to GMAIL_USER if empty
SMTP_FROM_EMAIL=CounsellorPro <yourname@gmail.com>

# Bearer token used by /api/cron/reminders
CRON_SECRET=

# IANA zone for slot times/reminders (e.g. UTC, Asia/Kolkata)
APP_TIMEZONE=UTC